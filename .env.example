FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///skillswap.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
AI_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MATCHING_USE_EMBEDDINGS=true
ENABLE_DEMO_SEED=false

# Optional: set to a Redis URL only when scaling Socket.IO across multiple web instances.
# SOCKETIO_REDIS_URL=redis://localhost:6379/3

